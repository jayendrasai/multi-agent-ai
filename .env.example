# Core Application
APP_NAME="AI Orchestrator"
APP_VERSION="1.0.0"
DEBUG=True
LOG_LEVEL="INFO"

# API Server
API_HOST="0.0.0.0"
API_PORT=8000
ALLOWED_ORIGINS='["http://localhost:3000"]'
API_REQUEST_TIMEOUT=30

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchestrator
DB_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/orchestrator"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Redis & Celery
REDIS_PORT=6379
REDIS_URL="redis://redis:6379/0"
REDIS_MAX_CONNECTIONS=100
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300

# LLM Configuration
LLM_API_KEY="your-llm-api-key-here"
LLM_MODEL_NAME="gemini-3.6-flash"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=1

# External Tools
SEARXNG_BASE_URL="http://searxng:8080"
OPENWEATHER_API_KEY="your-openweather-key"
TOOL_TIMEOUT=15
TOOL_MAX_RETRIES=5
SEARCH_TIMEOUT=10
SEARCH_RETRY_COUNT=3
SEARCH_CIRCUIT_BREAKER_THRESHOLD=5

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN_CALLS=1

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_RECONNECT_MAX_ATTEMPTS=10

# Agent Workflow Constraints
MAX_PLAN_STEPS=10
MAX_FEEDBACK_LOOPS=2
MAX_VALIDATION_LOOPS=1
MAX_GRAPH_ITERATIONS=30
QUALITY_THRESHOLD=0.7
WORKFLOW_STALE_TIMEOUT=600

# Observability
OTEL_EXPORTER_ENDPOINT="http://otel-collector:4317"
OTEL_SERVICE_NAME="ai-orchestrator"
PROMETHEUS_PORT=9090
# Authentication and result caching
SESSION_COOKIE_NAME=orchestrator_session
SESSION_LIFETIME_SECONDS=1209600
SESSION_COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=10
CACHE_TTL_SECONDS=86400
CACHE_VERSION=v1
